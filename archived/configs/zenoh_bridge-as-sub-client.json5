// Bridge **Zenoh → ROS subscribers** (allow all topics, like **`zenoh_bridge-as-pub-client`** publishers).

{
  mode: "client",

  scouting: {
    multicast: {
      enabled: false,
    },
  },

  connect: {
    endpoints: ["tcp/127.0.0.1:7447"],
  },

  plugins: {
    ros2dds: {
      ros_automatic_discovery_range: "LOCALHOST",
      allow: {
        publishers: [],
        subscribers: ["/.*"],
        service_servers: [],
        service_clients: [],
        action_servers: [],
        action_clients: [],
      },
    },
  },
}
